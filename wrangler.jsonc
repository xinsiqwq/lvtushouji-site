{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lvtushouji-site-local",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/__setup"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lvtushouji-local-db",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "lvtushouji-local-media",
      "remote": false
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ARENA_ROOM",
        "class_name": "ArenaRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ArenaRoomDO"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
