{
  "name": "lvtushouji-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:fonts": "uv run --with fonttools==4.66.1 --with brotli python scripts/build-fonts.py",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "d1:migrate:local": "wrangler d1 migrations apply lvtushouji-local-db --local",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test -c tests/e2e/playwright.config.ts --project=desktop-dark --project=mobile-dark tests/e2e/specs/tier1-home-design.spec.ts",
    "test:e2e:home": "playwright test -c tests/e2e/playwright.config.ts --project=desktop-dark --project=mobile-dark tests/e2e/specs/tier1-home-design.spec.ts tests/e2e/specs/tier2-home-design.spec.ts"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.19",
    "lucide-react": "^1.77.0",
    "maplibre-gl": "^6.19.0",
    "motion": "^14.14.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^6.4.6",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  }
}
